{
  "realm": "fraud-detection-engine",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "fraud-detection-engine",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "fraud-engine-secret",
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "openid",
        "fraud:evaluate"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "fraud-detection-engine-public",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "openid",
        "fraud:evaluate"
      ],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "fraud:evaluate",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "fraud-detection-engine-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fraud-detection-engine",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "fraud-tester",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    }
  ]
}
